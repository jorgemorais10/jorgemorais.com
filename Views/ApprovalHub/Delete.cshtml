@model ApprovalHub

@{
    ViewData["Title"] = $"Eliminar Pedido #{Model.IdApprovalHub}";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="text-danger"><i class="bi bi-trash"></i> Eliminar Pedido #@Model.IdApprovalHub</h1>
    </div>
</div>

<div class="alert alert-danger">
    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Atenção!</h4>
    <p>Tem a certeza que deseja eliminar este pedido de aprovação?</p>
    <hr>
    <p class="mb-0">Esta ação não pode ser desfeita. Todas as dimensões e anexos associados também serão eliminados.</p>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">Detalhes do Pedido</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID:</dt>
            <dd class="col-sm-9">@Model.IdApprovalHub</dd>

            <dt class="col-sm-3">Tipo de Fatura:</dt>
            <dd class="col-sm-9">@Model.TipoFatura</dd>

            <dt class="col-sm-3">Nº Fatura:</dt>
            <dd class="col-sm-9">@Model.NumFatura</dd>

            <dt class="col-sm-3">Fornecedor:</dt>
            <dd class="col-sm-9">@Model.FornecedorNome</dd>

            <dt class="col-sm-3">Data Documento:</dt>
            <dd class="col-sm-9">@Model.DataDocumento?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Valor Total:</dt>
            <dd class="col-sm-9"><strong class="text-success">@Model.ValorTotal.ToString("C2")</strong></dd>

            <dt class="col-sm-3">Estado:</dt>
            <dd class="col-sm-9">
                <span class="badge @GetEstadoBadgeClass(Model.Estado)">@Model.Estado</span>
            </dd>

            <dt class="col-sm-3">Criado Por:</dt>
            <dd class="col-sm-9">@Model.CriadoPor</dd>

            <dt class="col-sm-3">Criado Em:</dt>
            <dd class="col-sm-9">@Model.CriadoEm?.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-4">
    <input type="hidden" asp-for="IdApprovalHub" />

    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
        <a asp-action="Details" asp-route-id="@Model.IdApprovalHub" class="btn btn-info">
            <i class="bi bi-eye"></i> Ver Detalhes
        </a>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Confirmar Eliminação
        </button>
    </div>
</form>

@functions {
    string GetEstadoBadgeClass(string? estado)
    {
        return estado switch
        {
            "Pendente" => "bg-warning text-dark",
            "Aprovado" => "bg-success",
            "Rejeitado" => "bg-danger",
            "Em Análise" => "bg-info",
            _ => "bg-secondary"
        };
    }
}
